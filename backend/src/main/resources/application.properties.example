# ===== SERVIDOR =====
server.port=8080

# ===== SUPABASE / POSTGRESQL =====
spring.datasource.url=jdbc:postgresql://your-project.pooler.supabase.com:5432/postgres
spring.datasource.username=postgres.your-project-ref
spring.datasource.password=your-supabase-db-password
spring.datasource.driver-class-name=org.postgresql.Driver

# ===== JPA =====
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=Europe/Madrid

# ===== NAMING STRATEGY (snake_case en BD -> camelCase en Java) =====
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# ===== JACKSON =====
spring.jackson.date-format=yyyy-MM-dd
spring.jackson.serialization.write-dates-as-timestamps=false

# ===== LOGGING =====
logging.level.com.ingresosgastos=INFO
logging.level.org.springframework.web=WARN
